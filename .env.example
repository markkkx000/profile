# Environment Variables
# Copy this file to .env and fill in your values

# Your GitHub username (required)
VITE_GITHUB_USERNAME=markkkx000

# GitHub Personal Access Token (optional — needed for GraphQL API to fetch pinned repos)
# Generate one at: https://github.com/settings/tokens
# Required scope: "public_repo" (read-only access to public repositories)
#
# IMPORTANT: For local development, set this in .env (which is git-ignored).
# For GitHub Actions deployment, add this as a repository secret named GH_TOKEN.
# The workflow will inject it at build time.
#
# If no token is provided, the app falls back to the static JSON data in src/data/fallbackRepos.json
VITE_GITHUB_TOKEN=
